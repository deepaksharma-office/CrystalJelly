{% doc %}
  @prompt
    Create a testimonial section for a Shopify store with a clean, modern, and slightly elegant aesthetic.
    
    Section layout:
    - Full-width section with a soft light gray background
    - Centered content with generous vertical spacing
    - Max width around 1200px
    
    Header:
    - Add a centered heading: "What People Are Saying"
    - Use a serif or elegant font in a muted purple color
    - Add a small subheading below: "(Real reviews from real humans)" in a light gray sans-serif font
    
    Testimonials:
    - Display 3 testimonial cards in a row on desktop, 2 on tablet, 1 on mobile
    - Each card should have:
      - Light gray or off-white background
      - Rounded corners (12–16px)
      - Padding (20–24px)
      - Subtle shadow or flat minimal style
    
    Inside each card:
    - Add a 5-star rating at the top in a soft teal color
    - Below the stars, include italic testimonial text
    - Add customer name at the bottom in muted purple, prefixed with a dash
    
    Sample testimonials:
    1. "These candles are literally magic. I bought three more within a week." — Sarah M.
    2. "Love the snarky vibes. Finally a brand that gets it. The patches are chef's kiss." — Mike R.
    3. "Veteran-owned, woman-owned, and they make quality stuff. That's a win-win-win." — Jessica L.
    
    Style:
    - Keep typography clean and readable
    - Use soft, neutral tones with subtle accent colors
    - Ensure spacing and alignment feel balanced and premium
    - Optimize for mobile responsiveness
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
  }

  .ai-testimonials-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    {% if block.settings.card_shadow %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: italic;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    font-family: {{ block.settings.author_font.family }}, {{ block.settings.author_font.fallback_families }};
    font-weight: {{ block.settings.author_font.weight }};
    font-style: {{ block.settings.author_font.style }};
    color: {{ block.settings.author_color }};
    font-size: {{ block.settings.author_size }}px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-testimonials-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.65);
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<testimonials-block-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    <div class="ai-testimonials-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-testimonials-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-testimonials-grid-{{ ai_gen_id }}">
      {% if block.settings.testimonial_1_text != blank %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <p class="ai-testimonial-text-{{ ai_gen_id }}">{{ block.settings.testimonial_1_text }}</p>
          {% if block.settings.testimonial_1_author != blank %}
            <p class="ai-testimonial-author-{{ ai_gen_id }}">— {{ block.settings.testimonial_1_author }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.testimonial_2_text != blank %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <p class="ai-testimonial-text-{{ ai_gen_id }}">{{ block.settings.testimonial_2_text }}</p>
          {% if block.settings.testimonial_2_author != blank %}
            <p class="ai-testimonial-author-{{ ai_gen_id }}">— {{ block.settings.testimonial_2_author }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.testimonial_3_text != blank %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <p class="ai-testimonial-text-{{ ai_gen_id }}">{{ block.settings.testimonial_3_text }}</p>
          {% if block.settings.testimonial_3_author != blank %}
            <p class="ai-testimonial-author-{{ ai_gen_id }}">— {{ block.settings.testimonial_3_author }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</testimonials-block-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('testimonials-block-{{ ai_gen_id }}', TestimonialsBlock{{ ai_gen_id }});
  })();
</script>

